<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DynaRealm.ViewModels"
        x:Class="DynaRealm.Views.DayPageListWindow"
        x:DataType="vm:DayPageListViewModel"
        Width="400"
        Height="500"
        Title="ページ一覧">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="{Binding DateText}"
                   FontSize="20"
                   FontWeight="Bold"/>

        <TextBlock Text="この日のページ一覧"
                   FontSize="14"/>

		<Button Content="＋ページ追加"
				HorizontalAlignment="Right"
				Click="OpenPageEditor_Click"/>

		<TextBlock Text="この日にページはありません"
				   Foreground="Gray"
				   FontSize="14"
				   IsVisible="{Binding HasNoPages}"/>

        <ItemsControl ItemsSource="{Binding Pages}"
					  IsVisible="{Binding HasPages}">
            <ItemsControl.ItemTemplate>
				<DataTemplate x:DataType="vm:CalendarPageItemViewModel">
                    <Border BorderBrush="Gray"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            Margin="0,4">
                        <Button Content="{Binding Title}"
								Tag="{Binding PageId}"
								Click="OpenPageDetail_Click"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Window>