<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:DynaRealm.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="DynaRealm.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		KeyDown="Window_KeyDown"
		Icon="/Assets/avalonia-logo.ico"
		Title="DynaRealm">

	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
		to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<Window.Styles>
		<!-- ページ画面用ボタン共通 -->
		<Style Selector="Button.pageCommand">
			<Setter Property="MinHeight" Value="34"/>
			<Setter Property="Padding" Value="14,6"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="FontSize" Value="13"/>
		</Style>

		<Style Selector="Button.backCommand">
			<Setter Property="Background" Value="#EEEEEE"/>
			<Setter Property="Foreground" Value="#333333"/>
		</Style>

		<Style Selector="Button.saveCommand">
			<Setter Property="Background" Value="#2F6FED"/>
			<Setter Property="Foreground" Value="#FFFFFF"/>
		</Style>

		<Style Selector="Button.deleteCommand">
			<Setter Property="Background" Value="#FDECEC"/>
			<Setter Property="Foreground" Value="#C62828"/>
		</Style>

		<!-- ページタイトル -->
		<Style Selector="TextBox.pageTitle">
			<Setter Property="FontSize" Value="38"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Foreground" Value="#222222"/>
		</Style>

		<Style Selector="TextBox.pageTitle:focus">
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<!-- プロパティ入力 -->
		<Style Selector="TextBox.propertyInput">
			<Setter Property="Width" Value="120"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="Background" Value="#F3F3F3"/>
			<Setter Property="Padding" Value="10,6"/>
			<Setter Property="FontSize" Value="14"/>
		</Style>

		<Style Selector="TextBox.propertyInput:focus">
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="Background" Value="#EFEFEF"/>
		</Style>

		<!-- 本文エリア -->
		<Style Selector="TextBox.pageBody">
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="VerticalContentAlignment" Value="Top"/>
		</Style>

		<Style Selector="TextBox.pageBody:focus">
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="Background" Value="Transparent"/>
		</Style>

		<!-- 学習ログ入力欄 -->
		<Style Selector="TextBox.learningInput">
			<Setter Property="MinHeight" Value="76"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="Background" Value="#F7F7F7"/>
			<Setter Property="Padding" Value="10"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="TextWrapping" Value="Wrap"/>
			<Setter Property="VerticalContentAlignment" Value="Top"/>
		</Style>

		<Style Selector="TextBox.learningInput:focus">
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="Background" Value="#F3F3F3"/>
		</Style>
	</Window.Styles>

	<Grid>
		<Border IsVisible="{Binding IsCalendarScreen}"
				Background="#F7F7F5">

			<ScrollViewer VerticalScrollBarVisibility="Auto"
						  HorizontalScrollBarVisibility="Disabled">

				<StackPanel Margin="20">
					<TextBlock Text="{Binding CurrentScreenTitle}" FontSize="24" Margin="0,0,0,10"/>

					<Button Content="＋ページ追加"
							HorizontalAlignment="Right"
							Margin="0,0,0,10"
							Click="OpenPageEditor_Click"/>

					<StackPanel Orientation="Horizontal"
								Spacing="8"
								Margin="0,0,0,10">
						<TextBox Name="SearchKeywordTextBox"
								 Width="250"
								 PlaceholderText="キーワード検索"/>

						<Button Content="検索"
								Width="80"
								Click="SearchButton_Click"/>
					</StackPanel>

					<StackPanel Orientation="Horizontal"
								Spacing="8"
								Margin="0,0,0,10">
						<Button Content="月表示"
								Width="100"
								Click="ShowMonthView_Click"/>

						<Button Content="日割り表示"
								Width="100"
								Click="ShowDayView_Click"/>
					</StackPanel>

					<!-- 今日の復習一覧 -->
					<Border IsVisible="{Binding IsLearningTabSelected}"
							Background="#FFFFFF"
							CornerRadius="14"
							Padding="16"
							Margin="0,0,0,10"
							BoxShadow="0 6 18 0 #16000000">

						<StackPanel Spacing="10">

							<TextBlock Text="今日の復習"
									   FontSize="18"
									   FontWeight="SemiBold"
									   Foreground="#333333"/>

							<TextBlock Text="今日復習する学習ログはありません"
									   Foreground="#888888"
									   IsVisible="{Binding HasNoTodayReviewItems}"/>

							<ItemsControl ItemsSource="{Binding TodayReviewItems}"
										  IsVisible="{Binding HasTodayReviewItems}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:LearningReviewItemViewModel">
										<Button Tag="{Binding PageId}"
												Click="OpenPageDetailFromDayView_Click"
												Background="Transparent"
												BorderThickness="0"
												Padding="0"
												HorizontalAlignment="Stretch"
												HorizontalContentAlignment="Stretch">

											<Border BorderBrush="#E5E5E5"
													BorderThickness="1"
													CornerRadius="8"
													Padding="10"
													Margin="0,4"
													Background="#FAFAFA">

												<StackPanel Spacing="4">
													<Grid ColumnDefinitions="*,Auto">
														<TextBlock Text="{Binding Title}"
																   FontSize="14"
																   FontWeight="SemiBold"
																   Foreground="#333333"/>

														<TextBlock Grid.Column="1"
																   Text="{Binding ReviewDateText}"
																   FontSize="12"
																   Foreground="#888888"/>
													</Grid>

													<TextBlock Text="{Binding TechTag}"
															   FontSize="12"
															   Foreground="#2F6FED"/>

													<TextBlock Text="{Binding NextAction}"
															   FontSize="13"
															   Foreground="#666666"
															   TextWrapping="Wrap"/>
												</StackPanel>
											</Border>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

					<Border IsVisible="{Binding IsMonthView}"
							Background="#FFFFFF"
							CornerRadius="14"
							Padding="16"
							BoxShadow="0 6 18 0 #16000000">
						<StackPanel>
							<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
								<ItemsControl ItemsSource="{Binding Tabs}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Button Content="{Binding Name}"
													Tag="{Binding Id}"
													Background="{Binding BackgroundColor}"
													Foreground="{Binding ForegroundColor}"
													Margin="4"
													Click="TabButton_Click"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>

								<StackPanel Grid.Column="1" Orientation="Horizontal">
									<Button Content="＜" Margin="4" Click="PreviousMonth_Click"/>
									<TextBlock Text="{Binding CurrentMonthText}" VerticalAlignment="Center" FontSize="18" Margin="8,0"/>
									<Button Content="＞" Margin="4" Click="NextMonth_Click"/>
								</StackPanel>
							</Grid>

							<ItemsControl ItemsSource="{Binding WeekDays}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<UniformGrid Columns="7"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding}" HorizontalAlignment="Center" FontWeight="Bold"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<ItemsControl ItemsSource="{Binding CalendarDays}" Margin="0,8,0,0">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<UniformGrid Columns="7" Rows="6"/>
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>

								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Button Click="DayCell_Click"
												Tag="{Binding}"
												Background="Transparent"
												BorderThickness="0"
												Padding="0"
												HorizontalAlignment="Stretch"
												VerticalAlignment="Stretch">
											<Border BorderBrush="Gray"
													BorderThickness="0.5"
													MinHeight="80"
													Padding="6"
													Background="{Binding BackgroundColor}">

												<StackPanel>
													<Border Background="{Binding DayNumberBackground}"
															CornerRadius="10"
															Padding="4"
															HorizontalAlignment="Left">
														<TextBlock Text="{Binding DayNumber}"
																   Foreground="{Binding DayNumberForeground}"/>
													</Border>

													<ItemsControl ItemsSource="{Binding VisiblePages}" Margin="0,6,0,0">
														<ItemsControl.ItemTemplate>
															<DataTemplate>
																<TextBlock Text="{Binding Title}"
																		   Margin="0,2,0,0"/>
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>

													<TextBlock Text="{Binding HiddenPageCount, StringFormat=+{0}件}"
															   Foreground="Gray"
															   Margin="0,4,0,0"
															   IsVisible="{Binding HasHiddenPages}"/>
												</StackPanel>
											</Border>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

					<Border IsVisible="{Binding IsDayView}"
							Background="#FFFFFF"
							CornerRadius="14"
							Padding="16"
							BoxShadow="0 6 18 0 #16000000">
						<StackPanel Margin="0,10,0,0" Spacing="8">
							<TextBlock Text="日割り表示"
									   FontSize="20"
									   FontWeight="Bold"/>

							<StackPanel Orientation="Horizontal"
										Spacing="8"
										VerticalAlignment="Center">
								<TextBlock Text="{Binding CurrentDaySchedule.DateText}"
										   FontSize="16"
										   VerticalAlignment="Center"/>

								<Button Content="&lt;"
										Width="32"
										Click="PreviousDay_Click"/>

								<Button Content="&gt;"
										Width="32"
										Click="NextDay_Click"/>
							</StackPanel>

							<Border BorderBrush="#DDDDDD"
									BorderThickness="1"
									CornerRadius="8"
									Padding="10"
									Background="#FAFAFA"
									IsVisible="{Binding CurrentDaySchedule.HasAllDayPages}">
								<StackPanel Spacing="6">
									<TextBlock Text="時間未設定"
											   FontWeight="Bold"
											   Foreground="Gray"/>

									<ItemsControl ItemsSource="{Binding CurrentDaySchedule.AllDayPages}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="vm:CalendarPageItemViewModel">
												<Button Tag="{Binding PageId}"
														Click="OpenPageDetailFromDayView_Click"
														Background="Transparent"
														BorderThickness="0"
														Padding="0"
														HorizontalAlignment="Stretch"
														HorizontalContentAlignment="Stretch">
													<Border Background="{Binding TabColor}"
															BorderBrush="{Binding TabBorderColor}"
															BorderThickness="1"
															CornerRadius="6"
															Padding="6"
															Margin="0,2,0,2">
														<TextBlock Text="{Binding Title}"/>
													</Border>
												</Button>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Border>

							<ScrollViewer MaxHeight="520">
								<Grid ColumnDefinitions="72,*"
									  Height="{Binding CurrentDaySchedule.TimeAxisHeight}">

									<!-- 左側：時間ラベル -->
									<ItemsControl Grid.Column="0"
												  ItemsSource="{Binding CurrentDaySchedule.Hours}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<StackPanel/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>

										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="vm:DayScheduleHourViewModel">
												<Border Height="64"
														BorderBrush="#EEEEEE"
														BorderThickness="0,0,1,1"
														Padding="0,8,8,0">
													<TextBlock Text="{Binding HourText}"
															   Foreground="#777777"
															   FontSize="13"
															   HorizontalAlignment="Right"
															   VerticalAlignment="Top"/>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>

									<!-- 右側：時間軸本体 -->
									<Grid Grid.Column="1"
										  Height="{Binding CurrentDaySchedule.TimeAxisHeight}">

										<!-- 背景の時間罫線 -->
										<ItemsControl ItemsSource="{Binding CurrentDaySchedule.Hours}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<StackPanel/>
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>

											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="vm:DayScheduleHourViewModel">
													<Border Height="64"
															BorderBrush="#EEEEEE"
															BorderThickness="0,0,0,1"
															Background="#FFFFFF"/>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>

										<!-- Pageカード重ね表示 -->
										<ItemsControl ItemsSource="{Binding CurrentDaySchedule.TimedPages}"
													  Height="{Binding CurrentDaySchedule.TimeAxisHeight}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<Grid/>
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>

											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="vm:CalendarPageItemViewModel">
													<Button Tag="{Binding PageId}"
															Click="OpenPageDetailFromDayView_Click"
															Background="Transparent"
															BorderThickness="0"
															Padding="0"
															HorizontalAlignment="Stretch"
															HorizontalContentAlignment="Stretch"
															VerticalAlignment="Top"
															Margin="{Binding DayCardMargin}"
															Height="{Binding Height}">
														<Border Background="{Binding TabColor}"
																BorderBrush="{Binding TabBorderColor}"
																BorderThickness="1"
																CornerRadius="6"
																Padding="8">
															<StackPanel>
																<TextBlock Text="{Binding TimeText}"
																		   FontSize="11"
																		   Foreground="Gray"
																		   IsVisible="{Binding HasTime}"/>

																<TextBlock Text="{Binding Title}"
																		   FontSize="13"
																		   FontWeight="SemiBold"/>
															</StackPanel>
														</Border>
													</Button>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</Grid>
								</Grid>
							</ScrollViewer>
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>
		</Border>

		<!-- ページ登録画面 -->
		<Border IsVisible="{Binding IsEditorScreen}"
				Background="#F7F7F5">
			<Grid Margin="28">

				<ScrollViewer VerticalScrollBarVisibility="Auto"
							  HorizontalScrollBarVisibility="Disabled">

					<Border MaxWidth="1180"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Top"
							Padding="56,40,56,48"
							Background="#FFFFFF"
							CornerRadius="16"
							BoxShadow="0 10 30 0 #22000000">

						<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
							  RowSpacing="28">

							<!-- 上部バー -->
							<Grid Grid.Row="0"
								  ColumnDefinitions="Auto,*,Auto">
								<Button Classes="pageCommand backCommand"
										Content="← 戻る"
										Width="100"
										Click="BackToCalendar_Click"/>

								<TextBlock Grid.Column="1"
										   Text="{Binding CurrentScreenTitle}"
										   FontSize="13"
										   Foreground="#999999"
										   VerticalAlignment="Center"
										   HorizontalAlignment="Center"/>

								<Button Grid.Column="2"
										Classes="pageCommand saveCommand"
										Content="保存"
										Width="100"
										Click="SaveEditor_Click"/>
							</Grid>

							<!-- ページタイトル -->
							<TextBox Grid.Row="1"
									 Classes="pageTitle"
									 Text="{Binding CurrentPageEditor.Title}"
									 PlaceholderText="無題"
									 HorizontalAlignment="Stretch"/>

							<!-- プロパティ欄 -->
							<Border Grid.Row="2"
									BorderBrush="#EEEEEE"
									BorderThickness="0,1,0,1"
									Padding="0,18">
								<Grid ColumnDefinitions="Auto,150,32,Auto,150,*"
									  VerticalAlignment="Center">

									<TextBlock Text="開始時間"
											   Foreground="#888888"
											   VerticalAlignment="Center"/>

									<TextBox Grid.Column="1"
											 Classes="propertyInput"
											 Text="{Binding CurrentPageEditor.StartTimeText}"
											 PlaceholderText="09:00"
											 Margin="12,0,0,0"/>

									<TextBlock Grid.Column="3"
											   Text="終了時間"
											   Foreground="#888888"
											   VerticalAlignment="Center"/>

									<TextBox Grid.Column="4"
											 Classes="propertyInput"
											 Text="{Binding CurrentPageEditor.EndTimeText}"
											 PlaceholderText="18:00"
											 Margin="12,0,0,0"/>
								</Grid>
							</Border>

							<!-- 学習ログ入力欄 -->
							<Border Grid.Row="3"
									IsVisible="{Binding CurrentPageEditor.IsLearningPage}"
									BorderBrush="#EEEEEE"
									BorderThickness="0,0,0,1"
									Padding="0,0,0,24">

								<StackPanel Spacing="16">

									<TextBlock Text="学習ログ"
											   FontSize="16"
											   FontWeight="SemiBold"
											   Foreground="#333333"/>

									<!-- 技術タグ・復習設定 -->
									<Grid ColumnDefinitions="Auto,170,32,Auto,Auto,32,Auto,150,*"
										  VerticalAlignment="Center">

										<TextBlock Text="技術タグ"
												   Foreground="#888888"
												   VerticalAlignment="Center"/>

										<ComboBox Grid.Column="1"
												  ItemsSource="{Binding CurrentPageEditor.TechTags}"
												  SelectedItem="{Binding CurrentPageEditor.TechTag, Mode=TwoWay}"
												  Width="150"
												  Margin="12,0,0,0"/>

										<CheckBox Grid.Column="3"
												  Content="復習する"
												  IsChecked="{Binding CurrentPageEditor.ReviewRequired, Mode=TwoWay}"
												  VerticalAlignment="Center"/>

										<TextBlock Grid.Column="6"
												   Text="復習日"
												   Foreground="#888888"
												   VerticalAlignment="Center"/>

										<TextBox Grid.Column="7"
												 Classes="propertyInput"
												 Text="{Binding CurrentPageEditor.ReviewDateText}"
												 PlaceholderText="2026/06/20"
												 Margin="12,0,0,0"/>
									</Grid>

									<StackPanel Spacing="6">
										<TextBlock Text="今日やったこと"
												   Foreground="#666666"/>

										<TextBox Classes="learningInput"
												 Text="{Binding CurrentPageEditor.DidToday}"
												 AcceptsReturn="True"
												 PlaceholderText="今日取り組んだ内容を書いてください"/>
									</StackPanel>

									<StackPanel Spacing="6">
										<TextBlock Text="学んだこと"
												   Foreground="#666666"/>

										<TextBox Classes="learningInput"
												 Text="{Binding CurrentPageEditor.Learned}"
												 AcceptsReturn="True"
												 PlaceholderText="新しく理解したことを書いてください"/>
									</StackPanel>

									<StackPanel Spacing="6">
										<TextBlock Text="詰まったこと"
												   Foreground="#666666"/>

										<TextBox Classes="learningInput"
												 Text="{Binding CurrentPageEditor.Stuck}"
												 AcceptsReturn="True"
												 PlaceholderText="難しかったこと、詰まった原因を書いてください"/>
									</StackPanel>

									<StackPanel Spacing="6">
										<TextBlock Text="解決したこと"
												   Foreground="#666666"/>

										<TextBox Classes="learningInput"
												 Text="{Binding CurrentPageEditor.Solved}"
												 AcceptsReturn="True"
												 PlaceholderText="どう解決したかを書いてください"/>
									</StackPanel>

									<StackPanel Spacing="6">
										<TextBlock Text="次にやること"
												   Foreground="#666666"/>

										<TextBox Classes="learningInput"
												 Text="{Binding CurrentPageEditor.NextAction}"
												 AcceptsReturn="True"
												 PlaceholderText="次に試すこと、復習することを書いてください"/>
									</StackPanel>

								</StackPanel>
							</Border>

							<!-- 自由メモ -->
							<TextBox Grid.Row="4"
									 Classes="pageBody"
									 Text="{Binding CurrentPageEditor.Body}"
									 AcceptsReturn="True"
									 TextWrapping="Wrap"
									 PlaceholderText="自由メモを書いてください"
									 MinHeight="220"
									 HorizontalAlignment="Stretch"
									 VerticalAlignment="Stretch"/>

						</Grid>
					</Border>

				</ScrollViewer>
			</Grid>
		</Border>
		<!-- ページ詳細画面 -->
		<Border IsVisible="{Binding IsDetailScreen}"
				Background="#F7F7F5">
			<Grid Margin="28">

				<ScrollViewer VerticalScrollBarVisibility="Auto"
							  HorizontalScrollBarVisibility="Disabled">

					<Border MaxWidth="1180"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Top"
							Padding="56,40,56,48"
							Background="#FFFFFF"
							CornerRadius="16"
							BoxShadow="0 10 30 0 #22000000">

						<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
							  RowSpacing="28">

							<!-- 上部バー -->
							<Grid Grid.Row="0"
								  ColumnDefinitions="Auto,*,Auto">
								<Button Classes="pageCommand backCommand"
										Content="← 戻る"
										Width="100"
										Click="BackToCalendar_Click"/>

								<TextBlock Grid.Column="1"
										   Text="{Binding CurrentScreenTitle}"
										   FontSize="13"
										   Foreground="#999999"
										   VerticalAlignment="Center"
										   HorizontalAlignment="Center"/>

								<StackPanel Grid.Column="2"
											Orientation="Horizontal"
											Spacing="8">
									<Button Classes="pageCommand deleteCommand"
											Content="削除"
											Width="100"
											Click="DeleteDetail_Click"/>

									<Button Classes="pageCommand saveCommand"
											Content="保存"
											Width="100"
											Click="SaveDetail_Click"/>
								</StackPanel>
							</Grid>

							<!-- ページタイトル -->
							<TextBox Grid.Row="1"
									 Classes="pageTitle"
									 Text="{Binding CurrentPageDetail.Title}"
									 PlaceholderText="無題"
									 HorizontalAlignment="Stretch"/>

							<!-- プロパティ欄 -->
							<Border Grid.Row="2"
									BorderBrush="#EEEEEE"
									BorderThickness="0,1,0,1"
									Padding="0,18">
								<StackPanel Spacing="12">

									<Grid ColumnDefinitions="90,*">
										<TextBlock Text="日付"
												   Foreground="#888888"
												   VerticalAlignment="Center"/>

										<TextBlock Grid.Column="1"
												   Text="{Binding CurrentPageDetail.DateText}"
												   Foreground="#555555"
												   VerticalAlignment="Center"/>
									</Grid>

									<Grid ColumnDefinitions="90,150,32,90,150,*"
										  VerticalAlignment="Center">

										<TextBlock Text="開始時間"
												   Foreground="#888888"
												   VerticalAlignment="Center"/>

										<TextBox Grid.Column="1"
												 Classes="propertyInput"
												 Text="{Binding CurrentPageDetail.StartTimeText}"
												 PlaceholderText="09:00"
												 Margin="12,0,0,0"/>

										<TextBlock Grid.Column="3"
												   Text="終了時間"
												   Foreground="#888888"
												   VerticalAlignment="Center"/>

										<TextBox Grid.Column="4"
												 Classes="propertyInput"
												 Text="{Binding CurrentPageDetail.EndTimeText}"
												 PlaceholderText="18:00"
												 Margin="12,0,0,0"/>
									</Grid>

								</StackPanel>
							</Border>

							<!-- 学習ログ入力欄 -->
							<Border Grid.Row="3"
									IsVisible="{Binding CurrentPageDetail.IsLearningPage}"
									BorderBrush="#EEEEEE"
									BorderThickness="0,0,0,1"
									Padding="0,0,0,24">

								<StackPanel Spacing="16">

									<TextBlock Text="学習ログ"
											   FontSize="16"
											   FontWeight="SemiBold"
											   Foreground="#333333"/>

									<!-- 技術タグ・復習設定 -->
									<Grid ColumnDefinitions="Auto,170,32,Auto,Auto,32,Auto,150,32,Auto,*"
										  VerticalAlignment="Center">

										<TextBlock Text="技術タグ"
												   Foreground="#888888"
												   VerticalAlignment="Center"/>

										<ComboBox Grid.Column="1"
												  ItemsSource="{Binding CurrentPageDetail.TechTags}"
												  SelectedItem="{Binding CurrentPageDetail.TechTag, Mode=TwoWay}"
												  Width="150"
												  Margin="12,0,0,0"/>

										<CheckBox Grid.Column="3"
												  Content="復習する"
												  IsChecked="{Binding CurrentPageDetail.ReviewRequired, Mode=TwoWay}"
												  VerticalAlignment="Center"/>

										<TextBlock Grid.Column="6"
												   Text="復習日"
												   Foreground="#888888"
												   VerticalAlignment="Center"/>

										<TextBox Grid.Column="7"
												 Classes="propertyInput"
												 Text="{Binding CurrentPageDetail.ReviewDateText}"
												 PlaceholderText="2026/06/20"
												 Margin="12,0,0,0"/>

										<CheckBox Grid.Column="9"
												  Content="復習済み"
												  IsChecked="{Binding CurrentPageDetail.ReviewDone, Mode=TwoWay}"
												  VerticalAlignment="Center"/>
									</Grid>

									<StackPanel Spacing="6">
										<TextBlock Text="今日やったこと"
												   Foreground="#666666"/>

										<TextBox Classes="learningInput"
												 Text="{Binding CurrentPageDetail.DidToday}"
												 AcceptsReturn="True"
												 PlaceholderText="今日取り組んだ内容を書いてください"/>
									</StackPanel>

									<StackPanel Spacing="6">
										<TextBlock Text="学んだこと"
												   Foreground="#666666"/>

										<TextBox Classes="learningInput"
												 Text="{Binding CurrentPageDetail.Learned}"
												 AcceptsReturn="True"
												 PlaceholderText="新しく理解したことを書いてください"/>
									</StackPanel>

									<StackPanel Spacing="6">
										<TextBlock Text="詰まったこと"
												   Foreground="#666666"/>

										<TextBox Classes="learningInput"
												 Text="{Binding CurrentPageDetail.Stuck}"
												 AcceptsReturn="True"
												 PlaceholderText="難しかったこと、詰まった原因を書いてください"/>
									</StackPanel>

									<StackPanel Spacing="6">
										<TextBlock Text="解決したこと"
												   Foreground="#666666"/>

										<TextBox Classes="learningInput"
												 Text="{Binding CurrentPageDetail.Solved}"
												 AcceptsReturn="True"
												 PlaceholderText="どう解決したかを書いてください"/>
									</StackPanel>

									<StackPanel Spacing="6">
										<TextBlock Text="次にやること"
												   Foreground="#666666"/>

										<TextBox Classes="learningInput"
												 Text="{Binding CurrentPageDetail.NextAction}"
												 AcceptsReturn="True"
												 PlaceholderText="次に試すこと、復習することを書いてください"/>
									</StackPanel>

								</StackPanel>
							</Border>

							<!-- 自由メモ -->
							<TextBox Grid.Row="4"
									 Classes="pageBody"
									 Text="{Binding CurrentPageDetail.Body}"
									 AcceptsReturn="True"
									 TextWrapping="Wrap"
									 PlaceholderText="自由メモを書いてください"
									 MinHeight="220"
									 HorizontalAlignment="Stretch"
									 VerticalAlignment="Stretch"/>

						</Grid>
					</Border>

				</ScrollViewer>
			</Grid>
		</Border>

		<!-- 背景暗転 -->
		<Border Background="#80000000"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				IsVisible="{Binding IsDayOverlayVisible}"
				PointerPressed="OverlayBackground_PointerPressed"/>

		<!-- 日付一覧オーバーレイ -->
		<Border Width="460"
				Padding="20"
				Background="#FFFFFF"
				BorderBrush="#CCCCCC"
				BorderThickness="1"
				CornerRadius="12"
				BoxShadow="0 8 24 0 #66000000"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				IsVisible="{Binding IsDayOverlayVisible}">

			<StackPanel Spacing="12">
				<Grid ColumnDefinitions="*,Auto">
					<TextBlock Text="{Binding SelectedDayPageList.DateText}"
							   FontSize="22"
							   FontWeight="Bold"/>
					<Button Grid.Column="1"
							Content="閉じる"
							Click="CloseDayOverlay_Click"/>
				</Grid>

				<TextBlock Text="この日のページ一覧"
						   FontSize="14"/>

				<TextBlock Text="この日にページはありません"
						   Foreground="Gray"
						   IsVisible="{Binding SelectedDayPageList.HasNoPages}"/>

				<ScrollViewer MaxHeight="220"
							  IsVisible="{Binding SelectedDayPageList.HasPages}">
					<ItemsControl ItemsSource="{Binding SelectedDayPageList.Pages}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:CalendarPageItemViewModel">
								<Border BorderBrush="#DDDDDD"
										BorderThickness="1"
										CornerRadius="6"
										Padding="8"
										Margin="0,4">
									<Button Content="{Binding Title}"
											Tag="{Binding PageId}"
											Background="#F7F7F7"
											BorderThickness="0"
											HorizontalAlignment="Stretch"
											HorizontalContentAlignment="Left"
											Padding="6"
											Click="OpenPageDetailFromOverlay_Click"/>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>

				<StackPanel Orientation="Horizontal"
							HorizontalAlignment="Right"
							Spacing="8">
					<Button Content="日割りを見る"
							Width="120"
							Click="ShowDayViewFromOverlay_Click"/>

					<Button Content="＋ページ追加"
							Width="120"
							Click="OpenPageEditorFromOverlay_Click"/>
				</StackPanel>
			</StackPanel>
		</Border>
	</Grid>
</Window>
