<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:DynaRealm.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		x:Class="DynaRealm.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		KeyDown="Window_KeyDown"
		Icon="/Assets/avalonia-logo.ico"
		Title="DynaRealm">

	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
		to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<Grid>
		<StackPanel Margin="20">
			<TextBlock Text="DynaRealm" FontSize="24" Margin="0,0,0,10"/>

			<Button Content="＋ページ追加"
					HorizontalAlignment="Right"
					Margin="0,0,0,10"
					Click="OpenPageEditor_Click"/>

			<StackPanel Orientation="Horizontal"
						Spacing="8"
						Margin="0,0,0,10">
				<TextBox Name="SearchKeywordTextBox"
						 Width="250"
						 PlaceholderText="キーワード検索"/>

				<Button Content="検索"
						Width="80"
						Click="SearchButton_Click"/>
			</StackPanel>

			<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
				<ItemsControl ItemsSource="{Binding Tabs}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Button Content="{Binding Name}"
									Tag="{Binding Id}"
									Background="{Binding BackgroundColor}"
									Foreground="{Binding ForegroundColor}"
									Margin="4"
									Click="TabButton_Click"/>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<StackPanel Grid.Column="1" Orientation="Horizontal">
					<Button Content="＜" Margin="4" Click="PreviousMonth_Click"/>
					<TextBlock Text="{Binding CurrentMonthText}" VerticalAlignment="Center" FontSize="18" Margin="8,0"/>
					<Button Content="＞" Margin="4" Click="NextMonth_Click"/>
				</StackPanel>
			</Grid>

			<ItemsControl ItemsSource="{Binding WeekDays}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<UniformGrid Columns="7"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding}" HorizontalAlignment="Center" FontWeight="Bold"/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<ItemsControl ItemsSource="{Binding CalendarDays}" Margin="0,8,0,0">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<UniformGrid Columns="7" Rows="6"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Button Click="DayCell_Click"
								Tag="{Binding}"
								Background="Transparent"
								BorderThickness="0"
								Padding="0"
								HorizontalAlignment="Stretch"
								VerticalAlignment="Stretch">
							<Border BorderBrush="Gray"
									BorderThickness="0.5"
									MinHeight="80"
									Padding="6"
									Background="{Binding BackgroundColor}">

								<StackPanel>
									<Border Background="{Binding DayNumberBackground}"
											CornerRadius="10"
											Padding="4"
											HorizontalAlignment="Left">
										<TextBlock Text="{Binding DayNumber}"
												   Foreground="{Binding DayNumberForeground}"/>
									</Border>

									<ItemsControl ItemsSource="{Binding VisiblePages}" Margin="0,6,0,0">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<TextBlock Text="{Binding Title}"
														   Margin="0,2,0,0"/>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>

									<TextBlock Text="{Binding HiddenPageCount, StringFormat=+{0}件}"
											   Foreground="Gray"
											   Margin="0,4,0,0"
											   IsVisible="{Binding HasHiddenPages}"/>
								</StackPanel>
							</Border>
						</Button>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</StackPanel>

		<!-- 背景暗転 -->
		<Border Background="#80000000"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				IsVisible="{Binding IsDayOverlayVisible}"
				PointerPressed="OverlayBackground_PointerPressed"/>

		<!-- 日付一覧オーバーレイ -->
		<Border Width="460"
				Padding="20"
				Background="#FFFFFF"
				BorderBrush="#CCCCCC"
				BorderThickness="1"
				CornerRadius="12"
				BoxShadow="0 8 24 0 #66000000"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				IsVisible="{Binding IsDayOverlayVisible}">

			<StackPanel Spacing="12">
				<Grid ColumnDefinitions="*,Auto">
					<TextBlock Text="{Binding SelectedDayPageList.DateText}"
							   FontSize="22"
							   FontWeight="Bold"/>
					<Button Grid.Column="1"
							Content="閉じる"
							Click="CloseDayOverlay_Click"/>
				</Grid>

				<TextBlock Text="この日のページ一覧"
						   FontSize="14"/>

				<TextBlock Text="この日にページはありません"
						   Foreground="Gray"
						   IsVisible="{Binding SelectedDayPageList.HasNoPages}"/>

				<ScrollViewer MaxHeight="220"
							  IsVisible="{Binding SelectedDayPageList.HasPages}">
					<ItemsControl ItemsSource="{Binding SelectedDayPageList.Pages}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:CalendarPageItemViewModel">
								<Border BorderBrush="#DDDDDD"
										BorderThickness="1"
										CornerRadius="6"
										Padding="8"
										Margin="0,4">
									<Button Content="{Binding Title}"
											Tag="{Binding PageId}"
											Background="#F7F7F7"
											BorderThickness="0"
											HorizontalAlignment="Stretch"
											HorizontalContentAlignment="Left"
											Padding="6"
											Click="OpenPageDetailFromOverlay_Click"/>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>

				<Button Content="＋ページ追加"
						HorizontalAlignment="Right"
						Width="120"
						Click="OpenPageEditorFromOverlay_Click"/>
			</StackPanel>
		</Border>
	</Grid>
</Window>
